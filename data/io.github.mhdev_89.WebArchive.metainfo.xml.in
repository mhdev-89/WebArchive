<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mhdev_89.WebArchive</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>WebArchive</name>
  <summary>Browse offline ZIM archives</summary>
  <description>
    <p>
      WebArchive is a desktop reader for ZIM archives, the offline format
      used to package entire websites — such as Wikipedia, Wiktionary, and
      Stack Exchange — for reading without an internet connection.
    </p>
    <p>
      Browse the contents of your ZIM files, search inside them, and open
      them just like the original web pages. You can also browse the Kiwix
      library catalog from within the app and download new archives directly
      to your ZIMs folder.
    </p>
  </description>

  <developer id="io.github.mhdev-89">
    <name>mhdev-89</name>
  </developer>

  <url type="homepage">https://github.com/mhdev-89/WebArchive</url>
  <url type="bugtracker">https://github.com/mhdev-89/WebArchive/issues</url>

  <translation type="gettext">webarchive</translation>
  <launchable type="desktop-id">io.github.mhdev_89.WebArchive.desktop</launchable>
  <content_rating type="oars-1.1" />

  <screenshots>

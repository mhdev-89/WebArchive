    <screenshot type="default">
      <caption>Browsing Farsi WikiPedia</caption>
      <image>https://raw.githubusercontent.com/mhdev-89/WebArchive/main/data/screenshots/img3.png</image>
    </screenshot>
  </screenshots>

  <releases>
